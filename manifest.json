{
  "manifest_version": 3,
  "name": "YouTube Members only Blocker",
  "version": "0.0.1",
  "description": "Hides/removes YouTube recommendations and shelf cards that are marked 'Members only'.",
  "icons": {
    "48": "assets/icons/logo.png"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Members-only Recs Blocker",
    "default_icon": {
      "48": "assets/icons/logo.png"
    },
    "default_popup": "popup/popup.html"
  }
}
